# ============================================================
# Matrics — пример файла окружения.
#   cp .env.example .env
# В этом файле НЕТ рабочих токенов и паролей. Для локального запуска
# достаточно заменить значения-заглушки; для работы бота нужен токен MAX.
# ============================================================

# ---------- PostgreSQL (обязательно) ----------
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=tamagotchi_db
# Логировать SQL-запросы (true только для отладки)
SQL_ECHO=false

# ---------- MAX (обязательно для бота и мини-приложения) ----------
# Токен чат-бота, выданный организаторами / платформой MAX
MAX_BOT_TOKEN=your_max_bot_token_here
# Ник бота без @ (используется в QR-диплинках https://max.ru/<ник>?startapp=...)
MAX_BOT_USERNAME=your_bot_username
# Публичный HTTPS-адрес мини-приложения (фронтенда)
WEBAPP_URL=https://example.com
MAX_API_URL=https://platform-api.max.ru
LONG_POLLING_TIMEOUT=30

# ---------- Безопасность ----------
# Токен администратора/куратора для админ-панели и служебных эндпоинтов.
# Если пусто — проверка отключена (только для локальной разработки!).
ADMIN_TOKEN=change_me_admin_token
# lenient — допускается ?user_id= без подписи MAX (веб-демо и dev);
# strict  — все пользовательские запросы требуют подписанный initData MAX.
AUTH_MODE=lenient
# Требовать подпись MAX initData для отметки на паре
CHECKIN_REQUIRE_MAX_AUTH=false
# Разрешить эндпоинт полной очистки БД (только для тестовых стендов)
ALLOW_DB_RESET=false

# ---------- Посещаемость и серии ----------
# Часовой пояс расписания (смещение от UTC), 3 = Москва
APP_UTC_OFFSET_HOURS=3
# Период смены кода занятия, секунд
LESSON_CODE_WINDOW_SECONDS=30
# Разрешать отметку только во время пары (±15 минут)
CHECKIN_ENFORCE_WINDOW=true
# «Заморозки» серии посещений на 30 дней
STREAK_FREEZES_PER_30D=2
# Сколько минут есть на решение «заморозить пропуск» (для демо можно 2)
STREAK_FREEZE_DECISION_MIN=720
# Через сколько минут после конца пары фиксировать пропуск
STREAK_MISS_GRACE_MIN=15
# Штраф satisfaction за пропуск без «заморозки»
MISSED_LESSON_SATISFACTION_PENALTY=10

# ---------- Мини-игра «Забег до пары» ----------
# Забегов с наградой в день: базовые + за каждую посещённую сегодня пару
GAME_BASE_RUNS=3
GAME_RUNS_PER_LESSON=2
# Монеты из игры: 1 монета персонажу за N монет на трассе, потолок за забег и за день
GAME_PICKUPS_PER_COIN=10
GAME_MAX_COINS_PER_RUN=10
GAME_DAILY_COIN_CAP=30
# Призы топ-3 группы по итогам недели (через запятую)
GAME_WEEKLY_PRIZES=15,10,5

# ---------- LLM (опционально) ----------
# openrouter | ollama. Без ключа сервисы используют детерминированную заглушку.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- Grafana (мониторинг) ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
